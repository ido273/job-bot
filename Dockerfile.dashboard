FROM python:3.11-slim

WORKDIR /app

RUN groupadd -r jobbot && useradd -r -g jobbot jobbot

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY config/ ./config/

RUN mkdir -p /app/data && chown -R jobbot:jobbot /app
USER jobbot

EXPOSE 8000
ENTRYPOINT ["uvicorn", "src.dashboard.app:app", "--host", "0.0.0.0", "--port", "8000"]
