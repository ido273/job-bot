# Secrets
.env
k8s/secret.yaml

# Personal data
# (CV/résumé uploads live under data/cvs/ -- already covered by data/ above.
# Deliberately not *cv*/*.pdf/*.docx here: those are unscoped substring/
# extension globs that also match source files like *.html templates
# containing "cv" -- caught src/dashboard/templates/cvs.html this way once.)
data/
*.sqlite3
*.sqlite3-journal

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS
.DS_Store
