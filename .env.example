# Copy to .env and fill in real values. Never commit the real .env.

# BotFather token, e.g. 123456789:AAExampleTokenNotReal
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat ID (get it from @userinfobot or the getUpdates API)
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (Meta for Developers app > WhatsApp product > API Setup).
# Only required if "whatsapp" is in notifications.channels in config.yaml.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Recipient in international format, no "+", e.g. 972501234567
WHATSAPP_RECIPIENT_NUMBER=

# WhatsApp inbound bot commands (scan/pause/resume) -- only needed if you set
# up the webhook (Meta for Developers app > WhatsApp > Configuration). The
# verify token is any string you choose, entered in both places when you
# configure the webhook. The app secret is from App Settings > Basic, used
# to verify incoming webhook requests are really from Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Path to the SQLite DB file. Overrides database.path in config/config.yaml if set.
# DB_PATH=data/jobbot.sqlite3

# Path to the YAML config file.
# CONFIG_PATH=config/config.yaml

# Dashboard basic auth (single user -- it holds your full application
# history and CVs). Required to run src/dashboard/app.py.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
